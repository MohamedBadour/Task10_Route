{
  "info": {
    "name": "Assignment10",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Signup",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\"name\": \"Mohamed Badour\", \"email\": \"badour@test.com\", \"password\": \"123456\", \"phone\": \"01012345678\", \"age\": 22}"},
            "url": "http://localhost:3000/auth/signup"
          }
        },
        {
          "name": "Signin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["var res = pm.response.json(); if(res.token) { pm.collectionVariables.set('token', res.token); }"]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\"email\": \"badour@test.com\", \"password\": \"123456\"}"},
            "url": "http://localhost:3000/auth/signin"
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Get Profile",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": "http://localhost:3000/users/profile"
          }
        },
        {
          "name": "Update Profile",
          "request": {
            "method": "PUT",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}, {"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\"name\": \"Mohamed Badour Updated\", \"phone\": \"01112345678\", \"age\": 23}"},
            "url": "http://localhost:3000/users/profile"
          }
        },
        {
          "name": "Delete Profile",
          "request": {
            "method": "DELETE",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": "http://localhost:3000/users/profile"
          }
        }
      ]
    }
  ],
  "variable": [
    {"key": "token", "value": ""}
  ]
}
